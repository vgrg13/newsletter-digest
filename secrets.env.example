# Copy to secrets.env and fill in the values from the OAuth setup.
# secrets.env is gitignored — do not commit it.
#
# Fill these in by running:
#   python get_refresh_token.py
# which walks you through Google Cloud setup and prints these three values.

GMAIL_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-client-secret"
GMAIL_REFRESH_TOKEN="1//0g..."

# The Gmail address the digest reads from and sends to.
GMAIL_ADDRESS="you@gmail.com"
